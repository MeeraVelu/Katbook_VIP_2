# =============================================================================
# Katbook VIP — the ONE environment template.
#
# Workflow:   cp .env.example .env   →   fill in the CHANGE_ME values
#             →   docker compose up -d
#
# .env is the only file the app reads (it is gitignored; keep your real secrets
# there, never here). This template is committed, so it must stay secret-free.
#
# Pick ONE database (edit DATABASE_URL below):
#   • EXTERNAL DB (default) — Supabase / cloud / native Postgres.  Start with:
#         docker compose up -d                  (postgres+migrate are skipped)
#     Migrate it ONCE by hand first:  alembic upgrade head
#     Supabase: use the SESSION POOLER string (port 5432) — NOT the direct host
#     db.<ref>.supabase.co (IPv6-only) and NOT the 6543 transaction pooler.
#   • SELF-CONTAINED DB — bundled Postgres in Docker (eval/testing).  Set
#     DATABASE_URL to the bundled service (see the commented line) and start with:
#         docker compose --profile infra up -d  (runs postgres + migrate for you)
#
# Redis is ALWAYS the bundled Compose service (managed DBs don't provide Redis).
# See docs/DEPLOYMENT.md → "Database options" for the full walkthrough.
# =============================================================================

# --- Database -----------------------------------------------------------------
# EXTERNAL (default). Supabase session pooler shown; swap host/user/pass/db for
# Aiven/Neon/native. Native host: use the LAN IP or host.docker.internal, because
# inside a container "localhost" is the CONTAINER, not the host.
DATABASE_URL=postgresql://postgres.CHANGE_ME:CHANGE_ME@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require
# SELF-CONTAINED alternative — bundled `postgres` service (used only under
# `--profile infra`). Uncomment this + the POSTGRES_* block, comment the line above.
# DATABASE_URL=postgresql://katbook:change-me-strong@postgres:5432/katbook_vip
# POSTGRES_USER=katbook
# POSTGRES_PASSWORD=change-me-strong
# POSTGRES_DB=katbook_vip

# SQLAlchemy pool (API)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=30000

# --- Redis (broker + result backend + worker heartbeat) -----------------------
# Bundled Compose service (always runs). Point elsewhere only for a managed Redis.
REDIS_URL=redis://redis:6379/0

# --- API auth / CORS ----------------------------------------------------------
# X-API-Key required by the API when set; leave blank to DISABLE auth (dev only).
API_KEY=change-me-api-key
# Comma-separated allowed origins for the frontend (use the exact origin in prod).
# Includes the bundled console (ui service, default :8080) + a typical dev SPA.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# Host port for the bundled operator console (ui service).
UI_PORT=8080
# Directory the API writes multipart uploads into (shared volume with the worker).
VIDEO_INBOX_DIR=/data/inbox
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200
# /ready returns 503 unless a worker GPU heartbeat is fresh; set 0 for CPU/dev.
READY_REQUIRES_GPU=1

# --- Pipeline profile & models ------------------------------------------------
# fast | balanced | quality | production | smoke   (production = RTX 5090)
KVIP_PROFILE=production
# Embedder + dimension MUST match the migrated vector() column (validated at start).
KVIP_EMBED_MODEL=BAAI/bge-m3
KVIP_EMBED_DIM=1024
# Keep CLIP+YOLO+OCR resident together on 32 GB (production default = 1).
KVIP_RESIDENT_VISUAL_STACK=1
# NVDEC GPU decode: auto | cuda | none  (auto falls back to CPU if unavailable).
KVIP_FFMPEG_HWACCEL=auto
# OCR scripts (en falls back automatically if ta/hi weights fail to load).
KVIP_OCR_LANGS=en,ta,hi
# opt-6.7b instead of opt-2.7b for richer captions (more VRAM): uncomment.
# KVIP_BLIP2_MODEL=Salesforce/blip2-opt-6.7b
# Where the worker writes frames/audio/checkpoints/results.
KVIP_WORK_DIR=/data/work

# --- Tagging LLM (vLLM) -------------------------------------------------------
# vllm (production) | inprocess (GPU box without vLLM) | stub (CPU smoke/CI)
KVIP_TAGGING_BACKEND=vllm
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY
# Upgrade to 14B later WITHOUT code changes: set VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
# and the vllm service `--model` to match.

# --- Search query embeddings (keeps the API ML-free) --------------------------
# OpenAI-compatible embeddings endpoint (e.g. the `embeddings` TEI service).
# Unset -> semantic/hybrid search degrade to keyword search.
EMBEDDINGS_URL=http://embeddings:80/v1
EMBEDDINGS_MODEL=BAAI/bge-m3
HNSW_EF_SEARCH=80

# --- Worker / Celery ----------------------------------------------------------
WORKER_CONCURRENCY=1
# Pin the worker to a specific GPU (second 5090 later -> another worker with =1).
CUDA_VISIBLE_DEVICES=0
HEARTBEAT_INTERVAL=30

# --- Hugging Face -------------------------------------------------------------
# Model cache (mounted volume) + optional token (models used here are ungated).
HF_HOME=/models
# HF_TOKEN=

# --- S3 batch processing (optional — only needed for bulk imports) ------------
# Used by scripts/s3_batch.py to pull videos from an S3 bucket and submit them
# through the normal API flow. Leave as-is if you never bulk-import from S3.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=ap-southeast-1
# S3_BUCKET=my-edu-videos

# --- Logging ------------------------------------------------------------------
KVIP_LOG_LEVEL=INFO
KVIP_LOG_FORMAT=json          # json | plain
