# =============================================================================
# Katbook VIP — PRODUCTION environment (EXTERNAL database).
#
# Use this when Postgres and Redis run NATIVELY on the server (outside Docker).
# Install them with:
#   sudo apt install postgresql-16 postgresql-16-pgvector redis-server
#
# Then create the database + user and migrate ONCE by hand (see
# docs/DEPLOYMENT.md → "Database options", Option B):
#   sudo -u postgres createuser katbook -P
#   sudo -u postgres createdb katbook_vip -O katbook
#   psql -U katbook -d katbook_vip -c "CREATE EXTENSION vector;"
#   alembic upgrade head
#
# Start the app WITHOUT the bundled DB (plain up skips the "infra" profile):
#   cp .env.production .env
#   docker compose up -d
#
# For a CLOUD managed DB (Aiven / Supabase / Neon — Option C), keep everything
# below but swap DATABASE_URL / DATABASE_URL_SYNC / REDIS_URL for the provider's
# connection strings (mind the added network latency on every DB write).
# Secrets live ONLY here (env); never commit `.env` (it is gitignored).
# =============================================================================

# --- External Postgres (native on the host, or a cloud provider) --------------
# From inside the Docker containers, "localhost" is the CONTAINER, not the host.
# On Linux add `--add-host=host.docker.internal:host-gateway` (or use the host's
# LAN IP / a cloud hostname) if the containers must reach a host-native Postgres.
DATABASE_URL=postgresql://katbook:CHANGE_ME@localhost:5432/katbook_vip
DATABASE_URL_SYNC=postgresql://katbook:CHANGE_ME@localhost:5432/katbook_vip
# SQLAlchemy pool (API)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_STATEMENT_TIMEOUT_MS=30000

# --- External Redis (broker + result backend + worker heartbeat) --------------
REDIS_URL=redis://localhost:6379/0

# --- API auth / CORS ----------------------------------------------------------
# X-API-Key required by the API when set; leave blank to DISABLE auth (dev only).
API_KEY=change-me-api-key
# Comma-separated allowed origins for the frontend (use the exact origin in prod).
# Includes the bundled console (ui service, default :8080) + a typical dev SPA.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
# Host port for the bundled operator console (ui service).
UI_PORT=8080
# Directory the API writes multipart uploads into (shared volume with the worker).
VIDEO_INBOX_DIR=/data/inbox
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=200
# /ready returns 503 unless a worker GPU heartbeat is fresh; set 0 for CPU/dev.
READY_REQUIRES_GPU=1

# --- Pipeline profile & models ------------------------------------------------
# fast | balanced | quality | production | smoke   (production = RTX 5090)
KVIP_PROFILE=production
# Embedder + dimension MUST match the migrated vector() column (validated at start).
KVIP_EMBED_MODEL=BAAI/bge-m3
KVIP_EMBED_DIM=1024
# Keep CLIP+YOLO+OCR resident together on 32 GB (production default = 1).
KVIP_RESIDENT_VISUAL_STACK=1
# NVDEC GPU decode: auto | cuda | none  (auto falls back to CPU if unavailable).
KVIP_FFMPEG_HWACCEL=auto
# OCR scripts (en falls back automatically if ta/hi weights fail to load).
KVIP_OCR_LANGS=en,ta,hi
# opt-6.7b instead of opt-2.7b for richer captions (more VRAM): uncomment.
# KVIP_BLIP2_MODEL=Salesforce/blip2-opt-6.7b
# Where the worker writes frames/audio/checkpoints/results.
KVIP_WORK_DIR=/data/work

# --- Tagging LLM (vLLM) -------------------------------------------------------
# vllm (production) | inprocess (GPU box without vLLM) | stub (CPU smoke/CI)
KVIP_TAGGING_BACKEND=vllm
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY
# Upgrade to 14B later WITHOUT code changes: set VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct
# and the vllm service `--model` to match.

# --- Search query embeddings (keeps the API ML-free) --------------------------
# OpenAI-compatible embeddings endpoint (e.g. the `embeddings` TEI service).
# Unset -> semantic/hybrid search degrade to keyword search.
EMBEDDINGS_URL=http://embeddings:80/v1
EMBEDDINGS_MODEL=BAAI/bge-m3
HNSW_EF_SEARCH=80

# --- Worker / Celery ----------------------------------------------------------
WORKER_CONCURRENCY=1
# Pin the worker to a specific GPU (second 5090 later -> another worker with =1).
CUDA_VISIBLE_DEVICES=0
HEARTBEAT_INTERVAL=30

# --- Hugging Face -------------------------------------------------------------
# Model cache (mounted volume) + optional token (models used here are ungated).
HF_HOME=/models
# HF_TOKEN=

# --- Logging ------------------------------------------------------------------
KVIP_LOG_LEVEL=INFO
KVIP_LOG_FORMAT=json          # json | plain
