# syntax=docker/dockerfile:1
# ---------------------------------------------------------------------------
# UI image — React SPA built with Vite, served by nginx.
#   stage 1: node:20-alpine  → tsc --noEmit && vite build → /app/dist
#   stage 2: nginx:alpine     → serve dist + reverse-proxy /api,/health,/ready
# The API image gains ZERO UI code/deps; the browser talks to the API through
# this container's same-origin proxy (see docker/nginx.conf).
# ---------------------------------------------------------------------------
FROM node:20-alpine AS build
WORKDIR /app

# install deps first (better layer caching). No lockfile is committed, so the
# exact pins in package.json resolve deterministically via `npm install`.
COPY ui/package.json ./
RUN npm install --no-audit --no-fund

# build the SPA (tsc -b type-checks, then vite bundles to dist/)
COPY ui/ ./
RUN npm run build

FROM nginx:alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=4s --retries=3 \
    CMD wget -qO- http://localhost/ >/dev/null 2>&1 || exit 1
